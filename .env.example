# Datos públicos del proyecto Supabase (se entregan al navegador para Auth)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=tu_clave_anon_publica

# Solo para que el panel admin pueda listar usuarios. Nunca se expone al navegador.
SUPABASE_SERVICE_ROLE_KEY=tu_clave_service_role

# IMPORTANTE: NO agregues WAVESPEED_API_KEY aquí.
# Cada usuario pega su propia key en la app y solo vive en sessionStorage.
